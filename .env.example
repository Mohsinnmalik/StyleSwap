MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/fitview?retryWrites=true&w=majority
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Vertex AI (virtual try-on generation)
# Either paste the full service-account JSON into GOOGLE_CREDENTIALS (recommended for Vercel),
# or set GOOGLE_APPLICATION_CREDENTIALS to a key file path for local development.
GOOGLE_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=virtual-try-on-001
